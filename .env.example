# MongoDB connection string.
#
# Local development: you can leave this unset entirely — the app spins up
# a temporary in-memory MongoDB automatically (see src/lib/db.ts). Data
# won't persist across restarts, but everything else works with zero setup.
#
# Production (Vercel): set this in Project Settings → Environment
# Variables (or via the "MongoDB Atlas" Storage integration, which sets it
# for you). Any of these names work: MONGODB_URI, MONGO_URI, DATABASE_URL,
# MONGODB_URL — the app checks all of them.
MONGODB_URI=
